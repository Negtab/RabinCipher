<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RabinCipher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="RabinCipher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Шифр Рабина"
        Width="900" Height="640"
        MinWidth="800" MinHeight="580">

    <Window.Styles>
        <FluentTheme />
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="#CC2200"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,2,0,0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12">

        <!-- ── Строка 0: параметры ключа ─────────────────────────────── -->
        <Border Grid.Row="0" Background="#F0F4FF" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,*,*,*">

                <!-- p -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="p (простое, p ≡ 3 mod 4)" FontWeight="SemiBold" FontSize="12"/>
                    <TextBox Text="{Binding PText}" Watermark="например: 7" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding PError}" Classes="error"
                               IsVisible="{Binding HasPError}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- q -->
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="q (простое, q ≡ 3 mod 4)" FontWeight="SemiBold" FontSize="12"/>
                    <TextBox Text="{Binding QText}" Watermark="например: 11" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding QError}" Classes="error"
                               IsVisible="{Binding HasQError}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- b -->
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="b (0 ≤ b &lt; n)" FontWeight="SemiBold" FontSize="12"/>
                    <TextBox Text="{Binding BText}" Watermark="например: 0" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding BError}" Classes="error"
                               IsVisible="{Binding HasBError}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- n (read-only) -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="n = p·q (автоматически)" FontWeight="SemiBold" FontSize="12"/>
                    <TextBox Text="{Binding NText}" IsReadOnly="True"
                             Background="#E8EDF8" Margin="0,4,0,0"/>
                    <TextBlock Text="Вычисляется из p и q"
                               FontSize="11" Foreground="#888" Margin="2,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Строка 1: режим + кнопки ──────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
            <RadioButton Content="Шифрование"  IsChecked="{Binding IsEncryptMode}" VerticalAlignment="Center"/>
            <RadioButton Content="Дешифрование" IsChecked="{Binding IsDecryptMode}" VerticalAlignment="Center"/>
            <Separator Width="1" Height="24" Background="#CCC" Margin="4,0"/>
            <Button Content="📂  Открыть файл"      Click="OpenFileClick"  IsEnabled="{Binding IsNotBusy}" Padding="12,6"/>
            <Button Content="▶  Выполнить"           Click="RunClick"
                    IsEnabled="{Binding CanRun}"
                    Background="#3A7BD5" Foreground="White" Padding="12,6"
                    ToolTip.Tip="Активно когда файл открыт и все параметры корректны"/>
            <Button Content="💾  Сохранить результат" Click="SaveFileClick" IsEnabled="{Binding IsNotBusy}" Padding="12,6"/>
        </StackPanel>

        <!-- ── Строка 2: статус + прогресс ───────────────────────────── -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#444"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>
            <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"
                         Height="16" IsVisible="{Binding IsBusy}"/>
        </StackPanel>

        <!-- ── Строка 3: превью ───────────────────────────────────────── -->
        <Grid Grid.Row="3" ColumnDefinitions="*,8,*">
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"
                           Text="Исходный файл (первые байты/блоки, десятичные)"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding SourcePreview}" IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Courier New" FontSize="12"
                             Background="#FAFAFA" BorderBrush="#CCC" AcceptsReturn="True"/>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" Background="Transparent"/>

            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"
                           Text="Результат (первые блоки, десятичные числа)"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding ResultPreview}" IsReadOnly="True" TextWrapping="Wrap"
                             FontFamily="Courier New" FontSize="12"
                             Background="#FAFAFA" BorderBrush="#CCC" AcceptsReturn="True"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ── Строка 4: подсказка ────────────────────────────────────── -->
        <TextBlock Grid.Row="4" HorizontalAlignment="Center" FontSize="11" Foreground="#888" Margin="0,6,0,0"
                   Text="Алгоритм Рабина · c = m(m+b) mod n · Дешифрование: КТО + Тонелли-Шенкс + расш. алгоритм Евклида"/>
    </Grid>
</Window>
